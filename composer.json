{
    "name": "fof/scavenger-hunt",
    "description": "Hide collectable parts around your forum and let members hunt them down to build seasonal collectables.",
    "keywords": [
        "flarum",
        "scavenger hunt",
        "treasure hunt",
        "game",
        "seasonal",
        "promotion"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/FriendsOfFlarum/scavenger-hunt/issues",
        "source": "https://github.com/FriendsOfFlarum/scavenger-hunt"
    },
    "homepage": "https://friendsofflarum.org",
    "funding": [
        {
            "type": "website",
            "url": "https://opencollective.com/fof/donate"
        }
    ],
    "require": {
        "flarum/core": "^2.0.0"
    },
    "authors": [
        {
            "name": "IanM",
            "email": "ian@flarum.org",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "FoF\\ScavengerHunt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FoF\\ScavengerHunt\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        },
        "flarum-extension": {
            "title": "FoF Scavenger Hunt",
            "category": "feature",
            "icon": {
                "name": "fas fa-binoculars",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/tags",
                "flarum/audit",
                "flarum/gdpr",
                "fof/gamification"
            ]
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "css": true,
                "locale": true,
                "gitConf": true,
                "githubActions": true,
                "prettier": true,
                "typescript": true,
                "bundlewatch": false,
                "backendTesting": true,
                "frontendTesting": true
            }
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0.0",
        "flarum/testing": "^2.0.0",
        "flarum/tags": "^2.0",
        "fof/gamification": "2.x-dev",
        "flarum/audit": "^2.0"
    },
    "suggest": {
        "flarum/tags": "Hide parts on tag tiles.",
        "fof/gamification": "Rank members by parts found and hunts completed on the leaderboard.",
        "flarum/audit": "Log hunt changes, completions and lookup-limit breaches.",
        "flarum/gdpr": "Include scavenger hunt data in exports and erasure."
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php"
    },
    "scripts-descriptions": {
        "analyse:phpstan": "Run static analysis",
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once."
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
